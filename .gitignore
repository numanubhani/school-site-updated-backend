uploads/*
!uploads/.gitkeep

# Logs
*.log
uvicorn_log.txt

# Dev utilities
db_check.py
claude history/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Packaging
*.egg-info/
dist/
build/
